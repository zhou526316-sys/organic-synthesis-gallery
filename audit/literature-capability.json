    "preferNewestStableCompatibleImplementation": true,
    "requireMergedToMain": true,
    "preferPassingRelevantAuditOrSmokeChecks": true,
    "pinCapabilitySnapshotForWholeRun": true,
    "neverHotSwapDuringActiveRun": true,
    "force72HourRefetchWhenCapabilityFingerprintChanges": true,
    "doNotReuseOld24HourFetchAcrossCapabilityChange": true,
    "syncOnlyFallbackMustNeverRefetch": true,
    "recordCapabilityFingerprintInLastCompletedFetch": true
  }
}
