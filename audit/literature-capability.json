  "discoveryHints": {
    "literature": [
      "cloudflare/scripts/*literature*.mjs",
      ".github/workflows/*literature*.yml",
      "docs/*literature*.md"
    ],
    "toc": [
      "toc-collector/src/*",
      ".github/scripts/*toc*",
      ".github/workflows/*toc*",
